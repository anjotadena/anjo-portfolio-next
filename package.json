{
  "name": "anjo-portfolio",
  "private": true,
  "version": "2.2.0",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "npm run content:validate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "content:validate": "tsx --conditions=react-server scripts/validate-content.ts",
    "content:index": "tsx --conditions=react-server scripts/index-content.ts",
    "db:migrate": "tsx --conditions=react-server scripts/db-migrate.ts",
    "eval": "tsx --conditions=react-server scripts/eval.ts",
    "audit": "npm audit --audit-level=high",
    "dev:mock-openai": "node scripts/mock-openai.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "hooks:install": "node scripts/install-hooks.mjs",
    "release:patch": "npm version patch -m \"chore(release): v%s\" && git push --follow-tags",
    "release:minor": "npm version minor -m \"chore(release): v%s\" && git push --follow-tags",
    "release:major": "npm version major -m \"chore(release): v%s\" && git push --follow-tags"
  },
  "dependencies": {
    "gray-matter": "4.0.3",
    "lucide-react": "0.487.0",
    "next": "^16.3.5",
    "next-themes": "0.4.6",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "server-only": "^0.0.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.6",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "26.2.0",
    "@types/pg": "^8.23.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "4.7.0",
    "@vitest/coverage-v8": "^5.0.1",
    "eslint": "10.8.1",
    "eslint-config-next": "^16.3.5",
    "jsdom": "30.0.1",
    "rehype-highlight": "^7.0.2",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": "22.x"
  }
}
