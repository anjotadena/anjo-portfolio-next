# Copy to `.env.local` and fill in what you need. Nothing here is required to
# boot locally: without OPENAI_API_KEY the assistant answers extractively
# (quoting the portfolio) and retrieval is lexical. With OPENAI_API_KEY, run
# `npm run content:index` to build data/knowledge-index.json — no database.
# See README.md → Environment Variables.

# --- Site -------------------------------------------------------------------
# Absolute public URL. REQUIRED in production (canonical URLs, sitemap, OG).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- OpenAI -----------------------------------------------------------------
# Enables the language model (Responses API) and embeddings.
OPENAI_API_KEY=
# Optional OpenAI-compatible base URL (default https://api.openai.com/v1).
OPENAI_BASE_URL=
# auto | openai | extractive   (auto = openai when a key is present)
AI_PROVIDER=auto
AI_MODEL=gpt-4.1-mini
AI_MAX_OUTPUT_TOKENS=700
AI_REQUEST_TIMEOUT_MS=30000
# USD per 1M tokens, used only for the estimatedCostUsd log field.
AI_INPUT_COST_PER_1M=0.40
AI_OUTPUT_COST_PER_1M=1.60

# --- Embeddings / vector search ---------------------------------------------
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
# Vector store: the committed JSON index by default (no database).
KNOWLEDGE_INDEX_PATH=data/knowledge-index.json
# Optional PostgreSQL + pgvector for large corpora (docker compose up -d):
# DATABASE_URL=postgres://portfolio:portfolio@localhost:5432/portfolio
# auto | pgvector | file | lexical
#   auto = pgvector when DATABASE_URL + key are set, else file when a key is set, else lexical
RETRIEVAL_BACKEND=auto
RETRIEVAL_MAX_CHUNKS=6
# Cosine similarity floor for vector matches (0-1).
RETRIEVAL_MIN_SIMILARITY=0.3

# --- Abuse / cost controls ---------------------------------------------------
RATE_LIMIT_PER_MINUTE=10
RATE_LIMIT_PER_HOUR=50

# --- Misc -------------------------------------------------------------------
# Delay between streamed chunks in extractive mode (ms); 0 in tests.
CHAT_STREAM_DELAY_MS=12
# debug | info | warn | error
LOG_LEVEL=info
