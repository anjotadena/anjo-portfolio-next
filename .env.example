# All variables below are optional. Copy this file to `.env.local` and fill
# in only what you need — nothing here is required for the app to boot.

# OpenAI-compatible API key for the chat assistant. If unset, the chat API
# returns its grounded-fallback ("unconfigured") message instead of calling
# a model.
# OPENAI_API_KEY=

# Override the OpenAI-compatible API base URL (e.g. to point at a
# self-hosted or alternate OpenAI-compatible provider). Defaults to the
# official OpenAI API when unset.
# OPENAI_BASE_URL=

# Model name to use for chat completions. Falls back to a sensible default
# when unset.
# OPENAI_MODEL=

# Public site URL used for metadata (OpenGraph, canonical links, etc).
# Defaults to http://localhost:3000 in development.
# NEXT_PUBLIC_SITE_URL=

# How the contact form delivers submissions. Unset or "none" means the
# contact API honestly reports that delivery is not configured. "memory" is
# test-only (stores submissions in-process, no real delivery).
# CONTACT_TRANSPORT=
